{erl_opts, [debug_info]}.
%% No external deps yet — the NATS transport is stubbed until a maintained
%% Erlang NATS client is wired in. Keep this empty so `rebar3 compile` and
%% `rebar3 eunit` run hermetically in CI.
{deps, []}.

{profiles, [
    {test, [{erl_opts, [debug_info, nowarn_export_all]}]}
]}.

{shell, [
    {apps, [broker_supervisor]}
]}.

{relx, [
    {release, {broker_supervisor, "0.1.0"}, [broker_supervisor]},
    {dev_mode, true},
    {include_erts, false}
]}.
