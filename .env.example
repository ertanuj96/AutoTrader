# ──────────────────────────────────────────────
# PTS — Personal Trading System Configuration
# ──────────────────────────────────────────────

# Broker (INDstocks)
INDSTOCKS_API_TOKEN=your_token_here
INDSTOCKS_BASE_URL=https://api.indstocks.com
INDSTOCKS_WS_URL=wss://ws-prices.indstocks.com/api/v1/ws/prices

# Trading Mode (true = paper trading, false = LIVE — use with caution)
PAPER_TRADE=true

# Infrastructure
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=pts
CLICKHOUSE_USER=pts
CLICKHOUSE_PASSWORD=pts_secret

# Risk Limits
MAX_DAILY_LOSS=10000
MAX_POSITION_SIZE=50
MAX_EXPOSURE_PER_STRATEGY=100000
MAX_DRAWDOWN_PCT=5.0

# Strategy Defaults
DEFAULT_INSTRUMENTS=NSE:NIFTY,NSE:BANKNIFTY
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21

# Metrics
METRICS_PORT=8000

# Dashboard API
DASHBOARD_API_PORT=8001
